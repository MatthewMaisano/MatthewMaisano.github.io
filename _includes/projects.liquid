{% assign card_url = project.url | relative_url %}
{% if project.redirect %}{% assign card_url = project.redirect %}{% endif %}
<div class="pj-card">
  <a class="pj-card-link" href="{{ card_url }}">
    {% if project.thumb %}
      <div class="pj-card-thumb">
        <img src="{{ project.thumb | relative_url }}" alt="{{ project.title }} preview" loading="lazy">
      </div>
    {% endif %}
    <div class="pj-card-body">
      {% if project.kind %}<div class="pj-eyebrow">{{ project.kind }}{% if project.year %} · {{ project.year }}{% endif %}</div>{% endif %}
      <h2 class="pj-card-title">{{ project.title }}</h2>
      <p class="pj-card-desc">{{ project.description }}</p>
      {% if project.stack %}
        <div class="pj-card-footer">
          <ul class="pj-chips">
            {% for s in project.stack limit: 4 %}<li>{{ s }}</li>{% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
  </a>
</div>
